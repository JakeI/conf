priority 1000
snippet 'tex(.*)tex' "format TeX using utftex" wr
`!p
from subprocess import run
result = run(
    ['utftex', match.group(1)],
    capture_output=True,
    text=True,
    check=True,
)
snip.rv = result.stdout.rstrip()
`$0
endsnippet
