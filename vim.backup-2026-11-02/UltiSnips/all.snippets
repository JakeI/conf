priority 1000
snippet 'julia(.*)julia' "evaluate Julia expression" wr
`!p
import shutil
import subprocess

julia = shutil.which('julia') or shutil.which('julia.exe')

if julia is None:
    snip.rv = '[Julia executable not found]'
else:
    cmd = [
	    julia,
	    '--startup-file=no',
	    '--history-file=no',
	    '--compile=min',
	    '--print',
	    match.group(1),
	]
    snip.rv = subprocess.check_output(cmd).decode('utf-8').rstrip()
`
endsnippet
